{
    "name": "cheevauva/setcms",
    "description": "SetCMS",
    "type": "project",
    "require": {
        "php": ">=8.5.12",
        "doctrine/dbal": "4.2.1",
        "twig/twig": "v3.27.0",
        "altorouter/altorouter": "1.1.0",
        "laminas/laminas-diactoros": "3.10.0",
        "laminas/laminas-permissions-acl": "2.18.0",
        "laminas/laminas-httphandlerrunner": "2.14.0",
        "psr/http-server-handler": "1.0.2",
        "psr/http-server-middleware": "1.0.2",
        "cheevauva/uua": "v0.1.3"
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.17",
        "phpunit/phpunit": "12.5.8"
    },
    "autoload": {
        "psr-4": {
            "SetCMS\\": "SetCMS/",
            "Module\\": "Module/",
            "UUA\\": "UUA/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    }
}
