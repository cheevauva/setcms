{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_title %}Создать меню{% endblock %}

{% block content %}
    <setcms-editview>
        <action>{{ scLink(menu.id ? 'AdminMenuUpdate' : 'AdminMenuCreate', {id: (menu.id ?: scUUID()) }) }}</action>
        <redirect>{{ scLink('AdminMenuRead', {id: '${menu.id.uuid}'}) }}</redirect>
        <actions>
            <fields>
                <field type="submit" label="Сохранить"></field>
            </fields>
        </actions>
        <panels>
            <panel name="default" label="Основные данные" active="true">
                <fields>
                    <field type="hidden" name="menu.id" value="{{ menu.id|default(scUUID()) }}"></field>
                    <field type="input" name="menu.label" label="Надпись" value="{{ menu.label }}"></field>
                    <field type="input" name="menu.route" label="Маршрут" value="{{ menu.route }}"></field>
                    <field type="textarea" name="menu.params" label="Параметры" value="{{ menu.params|json_encode() }}"></field>
                </fields>
            </panel>
            <panel name="services" label="Служебные данные" active="false">
                <fields>
                    <field type="input" name="menu.dateCreated" label="Дата создания" disabled="1" value="{{ menu.dateCreated.format('Y-m-d H:i:s') }}"></field>
                    <field type="input" name="menu.dateModified" label="Дата изменения" disabled="1" value="{{ menu.dateCreated.format('Y-m-d H:i:s') }}"></field>
                </fields>
            </panel>
        </panels>
    </setcms-editview>
{% endblock %}