{% extends scShortPath(layout ?? 'layout_admin.twig') %}
{% import scShortPath('macros/crud.twig') as crud %}

{% block content_title %}{% if entity.id %}Редактировать{% else %}Создать{% endif %}{% endblock %}
{% block content %}
    {{ 
        crud.editview({
            action: url(entity.id ? 'AdminRAD01Update' : 'AdminRAD01Create', {id: (rad0101 ? entity.id : UUID()) }),
            redirect: url('AdminRAD01Read', {id: '${entity.id.uuid}'}),
            actions: {
                fields: [
                    {
                        type: 'submit',
                        label: 'Сохранить',
                    },
                ],
            },
            panels: [
                {
                    name: 'default',
                    label: 'Основные данные',
                    active: true,
                    fields: [
                        {
                            type: 'hidden',
                            name: 'entity.id',
                            value: entity.id|default(UUID())
                        },
                        {name: 'entity.field01', value: entity.field01, type: 'input', label: 'field01'},
                    ]
                }, 
            ]
        }) 
    }}
{% endblock %}