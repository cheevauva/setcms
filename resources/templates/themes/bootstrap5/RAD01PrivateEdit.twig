{% extends scShortPath(layout ?? 'layout_admin.twig') %}
{% import scShortPath('macros/crud.twig') as crud %}

{% block content_title %}{% if rad99.id %}Редактировать{% else %}Создать{% endif %}{% endblock %}
{% block content %}
    {{ 
        crud.editview({
            action: scLink(rad99.id ? 'AdminRAD99Update' : 'AdminRAD99Create', {id: (rad9901 ? rad99.id : scUUID()) }),
            redirect: scLink('AdminRAD99Read', {id: '${rad99.id.uuid}'}),
            actions: {
                fields: [
                    {
                        type: 'submit',
                        label: 'Сохранить',
                    },
                ],
            },
            panels: [
                {
                    name: 'default',
                    label: 'Основные данные',
                    active: true,
                    fields: [
                        {
                            type: 'hidden',
                            name: 'rad99.id',
                            value: rad99.id|default(scUUID())
                        },
                        {name: 'rad99.field01', value: rad99.field01, type: 'input', label: 'field01'},
                    ]
                }, 
            ]
        }) 
    }}
{% endblock %}