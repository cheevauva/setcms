{% extends scShortPath(layout ?? 'layout.twig') %}

{% block content %}
    <form class="setcms-form row g-1" 
          setcms-action="{{ url('UserDoLogin') }}"
          setcms-redirect="{{ url('UserProfile') }}"
          setcms-handler="login"
          >
        <setcms-field name="email" placeholder="Электронная почта" type="email"></setcms-field>
        <setcms-field name="password" placeholder="Пароль" type="password"></setcms-field>
        <setcms-field name="captcha" label="Код с картинки" type="captcha">
            <use>{{ useCaptcha }}</use>
            <generate>{{ url('CaptchaGenerate') }}</generate>
            <solve>{{ url('CaptchaSolve') }}</solve>
        </setcms-field>
        <div class="mb-2">
            <a href="{{ url('UserRestore') }}">Забыли пароль?</a>
        </div>
        <setcms-field type="submit" label="Отправить"></setcms-field>
    </form>
{% endblock %}