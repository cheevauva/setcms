{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_toolbar %}

{% endblock %}

{% block content_title %}Пользователи{% endblock %}

{% block content %}
    <setcms-listview>
        <header>
            <rows>
                <row>
                    <columns>
                        <field type="checkbox" name="id" value="selectall"></field>
                        <field type="text" value="Имя"></field>
                        <field type="text" value="Роль"></field>
                        <field type="text" value="Действия"></field>
                    </columns>
                </row>
            </rows>
        </header>
        <data>
            <rows>
                {% for entity in users %}
                    <row>
                        <columns>
                            <field type="checkbox" name="id[]" value="{{ entity.id.uuid }}"></field>
                            <field type="text" value="{{ entity.username }}"></field>
                            <field type="select" value="{{ entity.role.value }}">
                                <options>{{ {
                                'guest': 'Гость',
                                'entity': 'Пользователь',
                                'admin': 'Админ'
                            }|json_encode() }}</options>
                            </field>
                            <field type="actions">
                                <actions>
                                    <action label="Просмотр" route="{{ url('AdminUserRead', {id: entity.id}) }}">
                                        <access>{{ can('AdminUserRead') }}</access>
                                    </action>
                                    <action label="Редактировать" route="{{ url('AdminUserEdit', {id: entity.id}) }}">
                                        <access>{{ can('AdminUserEdit') }}</access>
                                    </action>
                                </actions>
                            </field>
                        </columns>
                    </row>
                {% endfor %}
            </rows>
        </data>
    </setcms-listview>
{% endblock %}