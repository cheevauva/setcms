{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_toolbar %}

{% endblock %}

{% block content_title %}Пользователи{% endblock %}

{% block content %}
    <setcms-listview>
        <header>
            <rows>
                <row>
                    <columns>
                        <field type="checkbox" name="id" value="selectall"></field>
                        <field type="text" value="Имя"></field>
                        <field type="text" value="Роль"></field>
                        <field type="text" value="Действия"></field>
                    </columns>
                </row>
            </rows>
        </header>
        <data>
            <rows>
                {% for user in users %}
                    <row>
                        <columns>
                            <field type="checkbox" name="id[]" value="{{ user.id.uuid }}"></field>
                            <field type="text" value="{{ user.username }}"></field>
                            <field type="select" value="{{ user.role.value }}">
                                <options>{{ {
                                'guest': 'Гость',
                                'user': 'Пользователь',
                                'admin': 'Админ'
                            }|json_encode() }}</options>
                            </field>
                            <field type="actions">
                                <actions>
                                    <action label="Просмотр" route="{{ scLink('AdminUserRead', {id: user.id}) }}">
                                        <access>{{ scHasAccess('AdminUserRead') }}</access>
                                    </action>
                                    <action label="Редактировать" route="{{ scLink('AdminUserEdit', {id: user.id}) }}">
                                        <access>{{ scHasAccess('AdminUserEdit') }}</access>
                                    </action>
                                </actions>
                            </field>
                        </columns>
                    </row>
                {% endfor %}
            </rows>
        </data>
    </setcms-listview>
{% endblock %}