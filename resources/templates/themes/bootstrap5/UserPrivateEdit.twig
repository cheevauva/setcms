{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_title %}Сохранить пользователя{% endblock %}

{% block content %}
    <setcms-editview>
        <action>{{ scLink(user.id ? 'AdminUserUpdate' : 'AdminUserCreate', {id: (user.id ?: scUUID()) }) }}</action>
        <redirect>{{ scLink('AdminUserRead', {id: '${user.id.uuid}'}) }}</redirect>
        <actions>
            <fields>
                <field type="submit" label="Сохранить"></field>
            </fields>
        </actions>
        <panels>
            <panel name="default" label="Основные данные" active="true">
                <fields>
                    <field type="hidden" name="user.id" value="{{ user.id|default(scUUID()) }}"></field>
                    <field type="select" name="user.role" label="Роль" value="{{ user.role.value }}">
                        <options>{{ {
                                'guest': 'Гость',
                                'user': 'Пользователь',
                                'admin': 'Админ'
                            }|json_encode() }}</options>
                    </field>
                </fields>
            </panel>
            <panel name="services" label="Служебные данные" active="false">
                <fields>
                    <field type="input" name="user.dateCreated" label="Дата создания" disabled="1" value="{{ user.dateCreated.format('Y-m-d H:i:s') }}"></field>
                    <field type="input" name="user.dateModified" label="Дата изменения" disabled="1" value="{{ user.dateCreated.format('Y-m-d H:i:s') }}"></field>
                </fields>
            </panel>
        </panels>
    </setcms-editview>
{% endblock %}