{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_title %}Сохранить пользователя{% endblock %}

{% block content %}
    <setcms-editview>
        <action>{{ url(entity.id ? 'AdminUserUpdate' : 'AdminUserCreate', {id: (entity.id ?: UUID()) }) }}</action>
        <redirect>{{ url('AdminUserRead', {id: '${entity.id.uuid}'}) }}</redirect>
        <actions>
            <fields>
                <field type="submit" label="Сохранить"></field>
            </fields>
        </actions>
        <panels>
            <panel name="default" label="Основные данные" active="true">
                <fields>
                    <field type="hidden" name="entity.id" value="{{ entity.id|default(UUID()) }}"></field>
                    <field type="select" name="entity.role" label="Роль" value="{{ entity.role.value }}">
                        <options>{{ {
                                'guest': 'Гость',
                                'entity': 'Пользователь',
                                'admin': 'Админ'
                            }|json_encode() }}</options>
                    </field>
                </fields>
            </panel>
            <panel name="services" label="Служебные данные" active="false">
                <fields>
                    <field type="input" name="entity.dateCreated" label="Дата создания" disabled="1" value="{{ entity.dateCreated.format('Y-m-d H:i:s') }}"></field>
                    <field type="input" name="entity.dateModified" label="Дата изменения" disabled="1" value="{{ entity.dateCreated.format('Y-m-d H:i:s') }}"></field>
                </fields>
            </panel>
        </panels>
    </setcms-editview>
{% endblock %}