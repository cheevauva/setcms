{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_title %}Создать пост{% endblock %}

{% block content %}
    <setcms-editview>
        <action>{{ scLink(post.id ? 'AdminPostUpdate' : 'AdminPostCreate', {id: (post.id ?: scUUID()) }) }}</action>
        <redirect>{{ scLink('AdminPostRead', {id: '${post.id.uuid}'}) }}</redirect>
        <actions>
            <fields>
                <field type="submit" label="Сохранить"></field>
            </fields>
        </actions>
        <panels>
            <panel name="default" label="Основные данные" active="true">
                <fields>
                    <field type="hidden" name="post.id" value="{{ post.id|default(scUUID()) }}"></field>
                    <field type="input" name="post.slug" label="Псевдоним" value="{{ post.slug }}"></field>
                    <field type="input" name="post.title" label="Заголовок" value="{{ post.title }}"></field>
                    <field type="textarea" name="post.message" label="Сообщение" value="{{ post.message }}"></field>
                </fields>
            </panel>
            <panel name="services" label="Служебные данные" active="false">
                <fields>
                    <field type="input" name="post.dateCreated" label="Дата создания" disabled="1" value="{{ post.dateCreated.format('Y-m-d H:i:s') }}"></field>
                    <field type="input" name="post.dateModified" label="Дата изменения" disabled="1" value="{{ post.dateCreated.format('Y-m-d H:i:s') }}"></field>
                </fields>
            </panel>
        </panels>
    </setcms-editview>
{% endblock %}