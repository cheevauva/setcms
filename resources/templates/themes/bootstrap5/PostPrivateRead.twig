{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_title %}{{ post.title }}{% endblock %}

{% block content_toolbar %}
    <a href="{{ scLink('AdminPostIndex') }}" class="btn btn-sm btn-outline-secondary">Список</a> 
    <a href="{{ scLink('AdminPostEdit', {id: post.id}) }}" class="btn btn-sm btn-outline-secondary">Редактировать</a>
{% endblock %}

{% block content %}
    <p>
        {{ post.message|raw }}
    </p>

    <p>
    <setcms-field type="input" name="dateCreated" label="Дата создания" disabled="1" value="{{ post.dateCreated.format('Y-m-d H:i:s') }}"></setcms-field>
    <setcms-field type="input" name="dateModified" label="Дата изменения" disabled="1" value="{{ post.dateCreated.format('Y-m-d H:i:s') }}"></setcms-field>
</p>
{% endblock %}