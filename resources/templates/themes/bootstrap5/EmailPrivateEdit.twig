{% extends scShortPath(layout ?? 'layout_admin.twig') %}

{% block content_title %}{% if email.id %}Редактировать{% else %}Создать{% endif %}{% endblock %}
{% block content %}
    <setcms-editview>
        <action>{{ scLink(email.id ? 'AdminEmailUpdate' : 'AdminEmailCreate', {id: (email.id ?: scUUID()) }) }}</action>
        <redirect>{{ scLink('AdminEmailRead', {id: '${email.id.uuid}'}) }}</redirect>
        <actions>
            <fields>
                <field type="submit" label="Сохранить"></field>
            </fields>
        </actions>
        <panels>
            <panel name="default" label="Основные данные" active="true">
                <fields>
                    <field type="hidden" name="email.id" value="{{ email.id|default(scUUID()) }}"></field>
                    <field type="input" name="email.subject" label="Subject" value="{{ email.subject }}"></field>
                </fields>
            </panel>
            <panel name="services" label="Служебные данные" active="false">
                <fields>
                    <field type="input" name="email.dateCreated" label="Дата создания" disabled="1" value="{{ email.dateCreated.format('Y-m-d H:i:s') }}"></field>
                    <field type="input" name="email.dateModified" label="Дата изменения" disabled="1" value="{{ email.dateCreated.format('Y-m-d H:i:s') }}"></field>
                </fields>
            </panel>
        </panels>
    </setcms-editview>
{% endblock %}