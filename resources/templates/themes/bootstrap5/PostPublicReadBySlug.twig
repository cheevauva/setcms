{% extends scShortPath(layout ?? 'layout.twig') %}

{% block title %}{{ options.title }} - {{ entity.title }}{% endblock %}

{% block content %}
    {% if entity %}
        <article class="blog-entity">
            <h2 class="blog-entity-title">{{ entity.title }}</h2>
            <p class="blog-entity-meta"><a href="#">{{ entity.attr('createdBy').username }}</a> опубликовал в {{ entity.dateCreated.format('H:i') }} {{ entity.dateCreated.format('d.m.Y') }}</p>
            <p>
                {{ entity.message|raw }}
            </p>
        </article>
    {% endif %}
{% endblock %}