<div class="position-sticky">
    <div class="p-4 mb-3 bg-light rounded">
        {% if can('UserProfile') %}
            Вы авторизованы, как {{ ctx.currentUser.username }}
            <br/>
        {% endif %}
        <span class="navbar-text">
            {% if can('UserLogin') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ url('UserLogin') }}">Вход</a>
            {% endif %}
            {% if can('UserRegistration') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ url('UserRegistration') }}">Регистрация</a>
            {% endif %}
            {% if can('UserProfile') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ url('UserProfile') }}">Профиль</a>
            {% endif %}
            {% if can('AdminHome') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ url('AdminHome') }}">Администрирование</a>
            {% endif %}
            {% if can('UserLogout') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ url('UserLogout') }}">Выйти</a>
            {% endif %}
        </span>
    </div>
</div>