{% extends scShortPath(layout ?? 'layout_popup.twig') %}

{% block content %}
    <form class="setcms-form row g-1" 
          setcms-action="{{ scLink('MigrationDoUp') }}"
          setcms-redirect="{{ scLink('Home') }}"
          >
        <setcms-field name="dbName" placeholder="База данных" type="text"></setcms-field>
        <setcms-field name="secretKey" placeholder="Секретный ключ" type="password"></setcms-field>
        <setcms-field  label="Отправить" type="submit"></setcms-field>
    </form>
{% endblock %}