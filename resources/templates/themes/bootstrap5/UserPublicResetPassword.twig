{% extends scShortPath(layout ?? 'layout.twig') %}

{% block content %}
    <form class="setcms-form row g-1" 
          setcms-action="{{ scLink('do_action', {module: 'User', action: 'doRestore'}) }}"
          setcms-redirect="{{ scLink('action', {module: 'User', action: 'doLogin'}) }}"
          setcms-handler="login"
          >
        <setcms-field name="code" placeholder="Код сброса" value="{{ user.resetPasswordTicket.code.value }}" type="hidden"></setcms-field>
        <setcms-field name="password" placeholder="Пароль" type="password"></setcms-field>
        <setcms-field name="password2" placeholder="Пароль (еще раз)" type="password"></setcms-field>
        <setcms-field type="submit" label="Отправить"></setcms-field>
    </form>
{% endblock %}
